{
	"schema_version": 1,
	"id": "pinia-colada-query",
	"display_name": "Pinia Colada query",
	"description": "Creates a complete Pinia Colada resource domain with queries, mutations, cache keys, and tests. Reruns against an existing resource folder require `boilersuit generate --skip-existing`.",
	"default_path": "src/queries",
	"fields": [
		{
			"token": "NAME",
			"label": "Query name",
			"description": "Used for the folder name, composable name, query key name, returned data name, and test name.",
			"hint": "Use lowercase kebab-case, e.g. user-list.",
			"required": true,
			"validation": {
				"pattern": "^[a-z0-9-]+$",
				"message": "Use lowercase kebab-case for query name."
			}
		},
		{
			"token": "ENDPOINT",
			"label": "Endpoint",
			"description": "The API endpoint passed to the request helper.",
			"hint": "Enter the endpoint without a leading slash, e.g. `users` or `account/profile`.",
			"required": true,
			"validation": {
				"pattern": "^[a-zA-Z0-9_/-]+$",
				"message": "Use a valid API endpoint path without a leading slash."
			}
		},
		{
			"token": "ID_NAME",
			"label": "ID parameter name",
			"description": "The JavaScript variable name used for the item ID in details queries.",
			"placeholder": "itemId",
			"default_value": "id",
			"required": true,
			"validation": {
				"pattern": "^[a-z][a-zA-Z0-9]*$",
				"message": "Use a camelCase JavaScript variable name."
			}
		},
		{
			"token": "API_TYPE",
			"label": "API type",
			"description": "Chooses which starter API helper and query generator imports to use.",
			"type": "select",
			"default_value": "fetch",
			"options": [
				{
					"label": "Fetch",
					"value": "fetch",
					"tokens": {
						"API_COMPOSABLE": "useApi",
						"API_IMPORT": "@/composables/api/use-api",
						"MOCK_API_IMPORT": "@test/unit/support/mock-api",
						"MOCK_API_NAME": "mockApi"
					}
				},
				{
					"label": "Xano",
					"value": "xano",
					"tokens": {
						"API_COMPOSABLE": "useApi",
						"API_IMPORT": "@/composables/api/use-api",
						"MOCK_API_IMPORT": "@test/unit/support/mock-api",
						"MOCK_API_NAME": "mockApi"
					}
				}
			],
			"required": true
		}
	],
	"files": [
		{
			"output_path": "keys.js",
			"template": "keys.js",
			"required": true
		},
		{
			"output_path": "list.js",
			"template": "domain-list.js",
			"required": true
		},
		{
			"output_path": "list.test.js",
			"template": "domain-list.test.js",
			"required": true
		},
		{
			"output_path": "details.js",
			"template": "domain-details.js",
			"required": true
		},
		{
			"output_path": "details.test.js",
			"template": "domain-details.test.js",
			"required": true
		},
		{
			"output_path": "actions.js",
			"template": "actions.js",
			"required": true
		},
		{
			"output_path": "actions.test.js",
			"template": "actions.test.js",
			"required": true
		},
		{
			"output_path": "helpers.js",
			"template": "helpers.js",
			"required": true
		},
		{
			"output_path": "helpers.test.js",
			"template": "helpers.test.js",
			"required": true
		},
		{
			"output_path": "index.js",
			"template": "index.js",
			"required": true
		}
	],
	"variants": [
		{
			"id": "server",
			"label": "Server query",
			"description": "Creates a parameterised list query that keeps previous data visible while its cache key changes.",
			"files": [
				{
					"output_path": "keys.js",
					"template": "server-keys.js",
					"required": true
				},
				{
					"output_path": "list.js",
					"template": "server-list.js",
					"required": true
				},
				{
					"output_path": "list.test.js",
					"template": "server-list.test.js",
					"required": true
				},
				{
					"output_path": "details.js",
					"template": "domain-details.js",
					"required": true
				},
				{
					"output_path": "details.test.js",
					"template": "domain-details.test.js",
					"required": true
				},
				{
					"output_path": "actions.js",
					"template": "actions.js",
					"required": true
				},
				{
					"output_path": "actions.test.js",
					"template": "actions.test.js",
					"required": true
				},
				{
					"output_path": "helpers.js",
					"template": "helpers.js",
					"required": true
				},
				{
					"output_path": "helpers.test.js",
					"template": "helpers.test.js",
					"required": true
				},
				{
					"output_path": "index.js",
					"template": "index.js",
					"required": true
				}
			]
		}
	]
}
