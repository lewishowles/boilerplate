{
	"name": "Vue app boilerplate",
	"description": "Creates a minimal Vue app with Boilersuit generators.",
	"placeholders": [
		{
			"token": "PROJECT_NAME",
			"label": "Project name",
			"description": "Used in package.json, README, and app metadata.",
			"placeholder": "my-new-project",
			"required": true
		},
		{
			"token": "BASE_URL",
			"label": "Base URL",
			"description": "The Vite base path for the deployed app.",
			"default_value": "/",
			"required": true
		},
		{
			"token": "SITE_TITLE",
			"label": "Site title",
			"description": "Used for the HTML title and social sharing metadata.",
			"placeholder": "My new app",
			"required": true
		},
		{
			"token": "SITE_DESCRIPTION",
			"label": "Site description",
			"description": "Used for the page description and social sharing metadata.",
			"placeholder": "A short description of the site.",
			"required": true
		},
		{
			"token": "SITE_URL",
			"label": "Site URL",
			"description": "The canonical production URL used in social sharing metadata.",
			"placeholder": "https://example.com",
			"required": true
		},
		{
			"token": "THEME_COLOUR",
			"label": "Theme colour",
			"description": "Browser and icon theme colour metadata.",
			"default_value": "#ffffff",
			"required": true
		},
		{
			"token": "API_TYPE",
			"label": "API type",
			"description": "Chooses the fetch, single-group Xano, or grouped Xano API setup.",
			"type": "select",
			"default_value": "fetch",
			"options": [
				{
					"label": "Fetch",
					"value": "fetch",
					"tokens": {
						"API_COMPOSABLE": "useApi",
						"API_IMPORT": "@/composables/api",
						"MOCK_API_IMPORT": "@test/unit/support/mock-api",
						"MOCK_API_NAME": "mockApi",
						"HAS_XANO": "false",
						"AUTH_API_MODE": "standard"
					}
				},
				{
					"label": "Xano",
					"value": "xano",
					"tokens": {
						"API_COMPOSABLE": "useApi",
						"API_IMPORT": "@/composables/api",
						"MOCK_API_IMPORT": "@test/unit/support/mock-api",
						"MOCK_API_NAME": "mockApi",
						"HAS_XANO": "true",
						"AUTH_API_MODE": "standard"
					}
				},
				{
					"label": "Xano (with grouped APIs)",
					"value": "xano-grouped",
					"tokens": {
						"API_COMPOSABLE": "useApi",
						"API_IMPORT": "@/composables/api",
						"MOCK_API_IMPORT": "@test/unit/support/mock-api",
						"MOCK_API_NAME": "mockApi",
						"HAS_XANO": "true",
						"AUTH_API_MODE": "grouped"
					}
				}
			],
			"required": true
		}
	],
	"package_dependencies": [
		{
			"name": "@xano/js-sdk",
			"version": "^3.0.1",
			"section": "dependencies",
			"include_when": { "HAS_XANO": "true" }
		}
	],
	"exclude_paths": ["scripts/**"],
	"files": [
		{
			"paths": ["src/composables/api/use-api/**"],
			"include_when": { "API_TYPE": "fetch" },
			"move_to": "src/composables/api"
		},
		{
			"paths": ["src/composables/api/use-auth-api/**"],
			"include_when": { "AUTH_API_MODE": "standard" }
		},
		{
			"paths": ["src/composables/api/xano/use-api/**"],
			"include_when": { "API_TYPE": "xano" },
			"move_to": "src/composables/api"
		},
		{
			"paths": ["src/composables/api/xano/xano-client.js"],
			"include_when": { "API_TYPE": "xano" }
		},
		{
			"paths": [
				"src/composables/api/xano/xano-api.js",
				"src/composables/api/xano/xano-api.test.js"
			],
			"include_when": { "HAS_XANO": "true" }
		},
		{
			"paths": ["src/composables/api/xano/grouped/use-api/**"],
			"include_when": { "API_TYPE": "xano-grouped" },
			"move_to": "src/composables/api"
		},
		{
			"paths": ["src/composables/api/xano/grouped/use-auth-api/**"],
			"include_when": { "API_TYPE": "xano-grouped" },
			"move_to": "src/composables/api/use-auth-api"
		},
		{
			"paths": ["src/composables/api/xano/grouped/use-group-api/**"],
			"include_when": { "API_TYPE": "xano-grouped" },
			"move_to": "src/composables/api/use-group-api"
		},
		{
			"paths": ["src/composables/api/xano/grouped/xano-client.js"],
			"include_when": { "API_TYPE": "xano-grouped" }
		},
		{
			"paths": ["test/unit/support/mock-api/index.js"],
			"include_when": { "API_TYPE": "fetch" }
		},
		{
			"paths": ["test/unit/support/mock-api/xano/index.js"],
			"include_when": { "API_TYPE": "xano" },
			"move_to": "test/unit/support/mock-api"
		},
		{
			"paths": ["test/unit/support/mock-api/xano/grouped/index.js"],
			"include_when": { "API_TYPE": "xano-grouped" },
			"move_to": "test/unit/support/mock-api"
		},
		{
			"paths": [".boilersuit/env/fetch/**"],
			"include_when": { "API_TYPE": "fetch" },
			"move_to": "."
		},
		{
			"paths": [".boilersuit/env/xano/**"],
			"include_when": { "API_TYPE": "xano" },
			"move_to": "."
		},
		{
			"paths": [".boilersuit/env/xano-grouped/**"],
			"include_when": { "API_TYPE": "xano-grouped" },
			"move_to": "."
		}
	]
}
